# Runtime connection to Neon (pooled hostname, sslmode=verify-full).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Direct connection used for Drizzle migrations. Do not expose to browsers.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Managed Better Auth endpoint from this SAME Neon branch.
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
# Generate independently for each environment: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=
# Canonical application origin; no trailing slash.
# Production: APP_URL=https://homeshare.dev
APP_URL=http://localhost:3000
# Google OAuth credentials are configured in Neon Auth per branch; they are
# intentionally not application environment variables.
# Vercel sends this as Authorization: Bearer <secret> to the cron route.
CRON_SECRET=
# Separate designated child branches only. Never enable on the live branch.
SEED_ALLOWED=false
# Write tests require ALL applicable guards; branch names do not establish safety.
# HOMESHARE_ENV=development
# TEST_DATABASE_HOST=ep-YOUR-CHILD-pooler.REGION.aws.neon.tech
# TEST_AUTH_HOST=ep-YOUR-CHILD.neonauth.REGION.aws.neon.tech
# TEST_APP_ORIGIN=http://localhost:3000
# Server-only activity interpretation. Choose an OpenRouter structured-output model.
# Both must be set to enable natural-language interpretation. Never use NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Optional independent 32+ character signing secret; defaults to NEON_AUTH_COOKIE_SECRET.
AI_PROPOSAL_SECRET=
